{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "tools/android-emulator-executor*.ts",
    "tools/gradle-wrapper-timeout*.ts",
    "tools/run-native-media-journey*.ts",
    "tools/check-native-media*.ts",
    "tools/check-android-journey*.ts",
    "tools/check-answered-elsewhere*.ts"
  ]
}
