{
  "name": "expo-callkit-telecom",
  "version": "0.5.0",
  "description": "LiveCommunicationKit + Jetpack Core-Telecom for Expo / React Native — native call UI, VoIP push, LiveKit-friendly audio. A modern react-native-callkeep alternative.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./app.plugin": "./app.plugin.js",
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json",
    "./types": {
      "types": "./build/types.d.ts"
    }
  },
  "scripts": {
    "build": "expo-module build && expo-module build plugin",
    "build:plugin": "expo-module build plugin",
    "clean": "expo-module clean",
    "lint": "expo-module lint",
    "test": "node --test test/contracts/composed-plugin.test.ts test/contracts/android-native-media.test.ts test/canonical/*.test.ts",
    "typecheck": "expo-module build && tsc --noEmit && tsc --noEmit -p plugin && tsc -p tsconfig.contract.json",
    "prepare": "expo-module prepare",
    "prepublishOnly": "expo-module prepublishOnly",
    "expo-module": "expo-module",
    "open:ios": "xed example/client/ios",
    "open:android": "open -a \"Android Studio\" example/client/android",
    "test:contracts": "bun test test/contracts/caller-example.test.ts && node --test test/contracts/composed-plugin.test.ts test/contracts/android-native-media.test.ts test/canonical/*.test.ts"
  },
  "keywords": [
    "callkit",
    "livecommunicationkit",
    "core-telecom",
    "androidx.core:core-telecom",
    "expo-module",
    "react-native",
    "expo",
    "pushkit",
    "fcm",
    "voip",
    "webrtc",
    "livekit"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/relayphone/expo-callkit-telecom.git"
  },
  "bugs": {
    "url": "https://github.com/relayphone/expo-callkit-telecom/issues"
  },
  "author": {
    "name": "Michael Fairley",
    "url": "https://github.com/mfairley"
  },
  "license": "MIT",
  "homepage": "https://github.com/relayphone/expo-callkit-telecom/tree/v2#readme",
  "dependencies": {
    "@relayphone/ios-voip-sdk": "https://github.com/relayphone/ios-voip-sdk/releases/download/v0.4.0/relayphone-ios-voip-sdk-0.4.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "~19.2.14",
    "eslint": "^9",
    "expo": "^57.0.24",
    "expo-module-scripts": "^56.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "react": "*",
    "react-native": "*",
    "expo-notifications": "*"
  },
  "files": [
    "build/index.js",
    "build/index.d.ts",
    "build/types.d.ts",
    "android/build.gradle",
    "android/src/main",
    "android/src/livekit",
    "android/src/withoutLivekit",
    "plugin/build/withConversations.*",
    "plugin/build/composedPlugin.*",
    "plugin/build/androidNativeMedia.*",
    "plugin/build/androidOptions.*",
    "app.plugin.js",
    "expo-module.config.json"
  ]
}
